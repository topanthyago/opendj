import { Theme } from "theme.slint";
import { Controls, ControlButton, ControlKnob } from "controls.slint";
import { PresetUi, TagChip } from "instruments.slint";
import { LineEdit } from "std-widgets.slint";
import { ListView, ScrollView } from "scroll.slint";

component PerformanceButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> lit;
    in property <bool> blink;
    in property <color> tint: Theme.accent;
    in property <length> font-size: 11px;
    callback clicked();
    height: 24px;
    border-radius: Theme.radius;
    border-width: lit || blink ? 2px : 1px;
    border-color: lit ? tint : blink ? tint.with-alpha(0.5) : Theme.border;
    background: ta.pressed ? Theme.control-pressed : Theme.control;
    Text { text: root.text; color: lit ? tint : Theme.text; font-size: root.font-size; font-weight: 600; overflow: elide; width: parent.width - 8px; horizontal-alignment: center; vertical-alignment: center; }
    opacity: enabled ? 1 : 0.35;
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component PerformanceTab inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <color> tint;
    callback clicked();
    height: 24px;
    border-radius: 4px;
    background: on ? tint.with-alpha(0.22) : ta.has-hover ? Theme.n-ffffff10 : transparent;
    Text { text: root.text; color: on ? Theme.text : Theme.text-dim; font-size: 9px; font-weight: 700; letter-spacing: 0.4px; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component GrooveMenuItem inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked;
    callback clicked();
    height: detail == "" ? 24px : 36px;
    border-radius: 5px;
    background: gmta.has-hover ? Theme.n-3a3a3d : transparent;
    VerticalLayout {
        x: 22px;
        width: parent.width - 28px;
        alignment: center;
        Text { text: root.text; color: Theme.text; font-size: 12px; }
        if detail != "": Text { text: root.detail; color: Theme.text-dim; font-size: 10px; overflow: elide; }
    }
    if checked: Text { x: 7px; text: "✓"; color: Theme.lilac-text; font-size: 12px; vertical-alignment: center; }
    gmta := TouchArea { clicked => { root.clicked(); } }
}

export component GrooveMenuBackground inherits Rectangle {
    background: Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.s-000000b0;
}

export component GrooveTempo inherits PerformanceButton {
    in property <string> g;
    in property <bool> menu-right-aligned: true;
    property <int> bpm-index: Controls.resolve(g, "bpm");
    property <float> bpm: Controls.value(bpm-index, Controls.tick);
    property <int> follow-index: Controls.resolve(g, "follow");
    property <bool> follow: Controls.value(follow-index, Controls.tick) > 0;
    property <bool> following: Controls.value(Controls.resolve(g, "following"), Controls.tick) > 0;
    property <int> scale-index: Controls.resolve(g, "tempo_scale");
    property <float> scale: Controls.value(scale-index, Controls.tick);
    function nudge(by: float) {
        Controls.set-value(follow-index, 0);
        Controls.set-value(bpm-index, max(40, min(220, round((bpm + by) * 10) / 10)));
    }
    text: round(bpm * 10) / 10 + (scale < 0.75 && follow ? " ½×" : scale > 1.5 && follow ? " 2×" : "") + " ▾";
    lit: following;
    clicked => { tempo-menu.show(); }
    tempo-menu := PopupWindow {
        y: root.height + 2px;
        x: menu-right-aligned ? root.width - 220px : 0px;
        width: 220px;
        close-policy: close-on-click-outside;
        GrooveMenuBackground { }
        VerticalLayout {
            padding: 6px;
            spacing: 6px;
            GrooveMenuItem {
                text: "Follow the mix";
                detail: "The playing track's tempo, else Link's";
                checked: follow;
                clicked => { Controls.set-value(follow-index, follow ? 0 : 1); }
            }
            HorizontalLayout {
                spacing: 4px;
                height: 26px;
                for step in [-1, -0.1]: PerformanceButton { width: 36px; height: 26px; text: step < -0.5 ? "−1" : "−.1"; clicked => { nudge(step); } }
                Text { horizontal-stretch: 1; text: round(bpm * 10) / 10 + " BPM"; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                for step in [0.1, 1]: PerformanceButton { width: 36px; height: 26px; text: step > 0.5 ? "+1" : "+.1"; clicked => { nudge(step); } }
            }
            HorizontalLayout {
                spacing: 4px;
                height: 26px;
                for s[i] in [0.5, 1, 2]: PerformanceButton {
                    horizontal-stretch: 1;
                    height: 26px;
                    text: i == 0 ? "Half time" : i == 1 ? "Normal" : "Double";
                    lit: follow && abs(scale - s) < 0.01;
                    clicked => {
                        Controls.set-value(scale-index, s);
                        Controls.set-value(follow-index, 1);
                    }
                }
            }
            ControlButton { group: g; key: "follow_breaks"; text: "FOLLOW TRACK BREAKS"; height: 26px; font-size: 10px; tint: root.tint; }
            ControlButton { group: g; key: "auto_fill_style"; text: "ADDITIVE FILLS"; height: 26px; font-size: 10px; tint: root.tint; }
            HorizontalLayout {
                spacing: 6px;
                ControlKnob { group: g; key: "break_sensitivity"; label: "BREAK"; size: 24px; }
                Text { text: "Break detection sensitivity"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                ControlKnob { group: g; key: "swing"; label: "SWING"; size: 24px; }
                Text { text: "Every second 16th plays late,\nfor a shuffle."; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
            }
        }
    }
}

export component GrooveFillBar inherits HorizontalLayout {
    in property <string> g;
    in property <bool> enabled: true;
    opacity: enabled ? 1 : 0.35;
    in property <color> tint;
    // The Sequencer as 4x4 pads instead of rows of 16.
    in-out property <bool> four;
    in property <bool> show-four: true;
    in property <bool> compact: false;
    property <int> auto-index: Controls.resolve(g, "auto_fill");
    property <int> auto: Controls.value(auto-index, Controls.tick);
    property <int> fill-index: Controls.resolve(g, "fill");
    property <int> remix-index: Controls.resolve(g, "remix");
    property <float> remix: Controls.value(remix-index, Controls.tick);
    property <bool> filling: Controls.value(Controls.resolve(g, "fill_playing"), Controls.tick) > 0;
    property <int> level: remix <= 0 ? 0 : floor(min(1, remix) * 15.999) + 1;
    height: 26px;
    spacing: 4px;
    if show-four: PerformanceButton {
        width: 40px;
        height: 26px;
        text: "4x4";
        lit: four;
        tint: tint;
        clicked => { four = !four; }
    }
    Rectangle {
        width: 168px;
        border-radius: 6px;
        background: Theme.well;
        HorizontalLayout {
            padding: 2px;
            spacing: 2px;
            for name[i] in ["NO FILLS", "AUTO 1", "AUTO 2"]: PerformanceTab {
                height: 22px;
                enabled: root.enabled;
                text: name;
                on: auto == i;
                tint: tint;
                clicked => { Controls.set-value(auto-index, i); }
            }
        }
    }
    Rectangle {
        width: 52px;
        border-radius: Theme.radius;
        border-width: filling ? 2px : 1px;
        border-color: filling ? tint : Theme.border;
        background: fta.pressed ? tint.with-alpha(0.4) : Theme.control;
        Text { text: "FILL"; color: filling ? tint : Theme.text; font-size: 10px; font-weight: 700; }
        fta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    Controls.set-value(fill-index, 1);
                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    Controls.set-value(fill-index, 0);
                }
            }
        }
    }
    Rectangle {
        horizontal-stretch: 1;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: level > 0 ? tint : Theme.border;
        background: Theme.s-00000040;
        HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            for i in 16: Rectangle {
                border-radius: 2px;
                background: i < level ? tint.with-alpha(0.35 + 0.6 * (i + 1) / 16) : Theme.n-ffffff10;
            }
        }
        Text {
            text: level > 0 ? "REMIX " + level : compact ? "REMIX · hold + slide" : "REMIX   hold and slide: hats · rolls · swap · all";
            color: level > 0 ? Theme.text : Theme.text-dim;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.4px;
        }
        rta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    Controls.set-value(remix-index, 0);
                }
            }
            moved => {
                if self.pressed {
                    Controls.set-value(remix-index, max(0.001, min(1, self.mouse-x / self.width)));
                }
            }
            changed pressed => {
                if self.pressed {
                    Controls.set-value(remix-index, max(0.001, min(1, self.mouse-x / self.width)));
                } else {
                    Controls.set-value(remix-index, 0);
                }
            }
        }
    }
}

// These indicators come from the audio engine. `following` identifies an
// external clock, without identifying whether its source is a deck or Link.
export component PerformanceStatus inherits HorizontalLayout {
    in property <string> g;
    in property <string> channel;
    in property <color> tint;
    in property <bool> looper: false;
    property <float> bpm: Controls.value(Controls.resolve(g, "bpm"), Controls.tick);
    property <bool> following: Controls.value(Controls.resolve(g, "following"), Controls.tick) > 0;
    property <bool> playing: Controls.value(Controls.resolve(channel, "play"), Controls.tick) > 0;
    property <bool> breaking: !looper && Controls.value(Controls.resolve(g, "break_active"), Controls.tick) > 0;
    property <bool> follows-breaks: !looper && Controls.value(Controls.resolve(g, "follow_breaks"), Controls.tick) > 0;
    property <bool> filling: !looper && Controls.value(Controls.resolve(g, "fill_playing"), Controls.tick) > 0;
    property <int> input: looper ? Controls.value(Controls.resolve(g, "input"), Controls.tick) : 0;
    property <int> bars: looper ? Controls.value(Controls.resolve(g, "length"), Controls.tick) : 0;
    property <float> level: Controls.value(Controls.resolve(channel, "vu_meter"), Controls.tick);
    height: 16px;
    spacing: 6px;
    Text {
        text: round(bpm * 10) / 10 + " BPM · " + (following ? "MIX / LINK" : "OWN TEMPO") + " · "
            + (!playing ? "STOPPED" : breaking ? "BREAK PAUSE" : filling ? "FILL / REMIX" : "PLAYING")
            + (!looper && follows-breaks && !breaking ? " · BREAK FOLLOW" : "")
            + (looper ? " · " + ["MIX", "MIC", "AUX", "INSTR.", "AUX 2", "AUX 3"][input] + " · " + bars + " BARS" : "");
        color: breaking ? Theme.c-ff9f0a : following ? tint : Theme.text-dim;
        font-size: 9px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        min-width: 0px;
    }
    Rectangle {
        width: 40px;
        height: 4px;
        border-radius: 2px;
        background: Theme.well;
        Rectangle { x: 0; width: parent.width * clamp(level, 0, 1); height: parent.height; background: tint; border-radius: 2px; }
    }
}

export struct GrooveKit {
    name: string,
    about: string,
    sounds: [string],
}

export struct GrooveName {
    name: string,
    about: string,
}

export struct GrooveGenre {
    name: string,
    grooves: [GrooveName],
}

export global GrooveUi {
    in property <[GrooveKit]> kits;
    in property <[GrooveGenre]> genres;
}

export component PresetTagger inherits PopupWindow {
    in property <int> deck;
    width: 300px;
    height: 2 * 18px + 4 * 28px + 16px;
    close-policy: close-on-click-outside;
    GrooveMenuBackground { }
    VerticalLayout {
        padding: 8px;
        spacing: 0px;
        for group[g] in ["TYPE", "CHARACTER"]: VerticalLayout {
            property <int> from: g == 0 ? 0 : PresetUi.type-count;
            property <int> to: g == 0 ? PresetUi.type-count : PresetUi.tag-names.length;
            Text { text: group; color: Theme.text-dim; font-size: 10px; height: 18px; vertical-alignment: center; }
            for row in 2: HorizontalLayout {
                spacing: 4px;
                padding-top: 3px;
                padding-bottom: 3px;
                height: 28px;
                alignment: start;
                for k in max(0, min(5, to - from - row * 5)): TagChip {
                    property <int> tag: from + row * 5 + k;
                    text: PresetUi.tag-names[tag];
                    on: PresetUi.has-tag(deck, tag);
                    clicked => { PresetUi.toggle-tag(deck, tag); }
                }
            }
        }
    }
}

// Asks a name for a new preset (`asking` 0) or a new name for preset
// `name` (1), then saves or renames.
export component PresetNamer inherits PopupWindow {
    in property <int> deck;
    in property <int> asking;
    in property <string> name;
    width: 280px;
    close-policy: close-on-click-outside;
    GrooveMenuBackground { }
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Text { text: asking == 0 ? "Name the new preset" : "Rename “" + name + "”"; color: Theme.text; font-size: 12px; }
        HorizontalLayout {
            spacing: 6px;
            field := LineEdit {
                text: asking == 1 ? name : "";
                placeholder-text: "Preset name";
                init => { self.focus(); }
                accepted => { done(); }
            }
            Rectangle {
                width: 60px;
                border-radius: 4px;
                background: ota.pressed ? Theme.control-pressed : Theme.accent;
                Text { text: "Save"; color: #000000; font-size: 12px; font-weight: 600; }
                ota := TouchArea { mouse-cursor: pointer; clicked => { done(); } }
            }
        }
    }
    function done() {
        if asking == 0 {
            PresetUi.save-as(deck, field.text);
        } else {
            PresetUi.rename(deck, field.text);
        }
        root.close();
    }
}

export component GroovePreset inherits PerformanceButton {
    in property <int> deck;
    property <string> name: PresetUi.name(deck);
    property <int> asking;
    text: (name != "" ? name : "Preset") + " ▾";
    clicked => { menu.show(); }
    menu := PopupWindow {
        y: root.height + 2px;
        width: 230px;
        // Previous, Next, the presets, then Save as new (and Save, Rename
        // and Tags with a preset playing), with their lines between.
        height: min(PresetUi.groove.length * 24px + (name != "" ? 206px : 110px), 440px);
        GrooveMenuBackground { }
        ScrollView {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            VerticalLayout {
                GrooveMenuItem { text: "‹ Previous preset"; clicked => { PresetUi.step(deck, -1); } }
                GrooveMenuItem { text: "› Next preset"; clicked => { PresetUi.step(deck, 1); } }
                Rectangle { height: 1px; background: Theme.border; }
                for p in PresetUi.groove: GrooveMenuItem {
                    text: p.name;
                    checked: p.name == name;
                    clicked => { PresetUi.load(deck, p.index); }
                }
                if PresetUi.groove.length > 0: Rectangle { height: 1px; background: Theme.border; }
                if name != "": GrooveMenuItem {
                    text: "Save";
                    detail: "Over “" + name + "”";
                    clicked => { PresetUi.save(deck); }
                }
                GrooveMenuItem {
                    text: "Save as new…";
                    clicked => {
                        asking = 0;
                        namer.show();
                    }
                }
                if name != "": GrooveMenuItem {
                    text: "Rename…";
                    clicked => {
                        asking = 1;
                        namer.show();
                    }
                }
                if name != "": GrooveMenuItem {
                    text: "Tags…";
                    detail: "What it is and how it sounds";
                    clicked => { tagger.show(); }
                }
            }
        }
    }
    tagger := PresetTagger {
        y: root.height + 2px;
        deck: deck;
    }
    namer := PresetNamer {
        y: root.height + 2px;
        deck: deck;
        asking: asking;
        name: name;
    }
}


export component GrooveDiceItems inherits VerticalLayout {
    in property <string> g;
    in property <int> track;
    callback picked();
    property <int> dice-index: Controls.resolve(g, "dice");
    property <int> row-index: Controls.resolve(g, "dice_row");
    for item[i] in [
        { name: "New groove", detail: "Fresh hits in the genre's style" },
        { name: "Mutate", detail: "Move a hit or two, keep the feel" },
        { name: "Busier", detail: "One more hit, on the strongest free step" },
        { name: "Calmer", detail: "One hit fewer, the weakest goes" },
        { name: "Even out", detail: "Same hits, spread evenly (Euclid)" },
        { name: "Shift later", detail: "Every hit a step later" },
        { name: "Shift earlier", detail: "Every hit a step earlier" },
    ]: GrooveMenuItem {
        text: track > 0 && i == 0 ? "New track" : item.name;
        detail: item.detail;
        clicked => {
            Controls.set-value(row-index, track);
            Controls.set-value(dice-index, i + 1);
            root.picked();
        }
    }
}

// The top bar's Dice: varies every unlocked track on the next bar, with
// Undo. It blinks while a variation waits for the bar.
export component GrooveDice inherits PerformanceButton {
    in property <string> g;
    in property <int> track;
    property <bool> pending: Controls.value(Controls.resolve(g, "dice_pending"), Controls.tick) > 0;
    property <bool> can-undo: Controls.value(Controls.resolve(g, "can_undo"), Controls.tick) > 0;
    property <bool> varying: Controls.value(Controls.resolve(g, "vary"), Controls.tick) > 0.01;
    text: "⚄";
    lit: varying;
    font-size: 16px;
    blink: pending && Controls.blink;
    clicked => { dice-menu.show(); }
    dice-menu := PopupWindow {
        y: root.height + 2px;
        width: 250px;
        GrooveMenuBackground { }
        VerticalLayout {
            padding: 4px;
            HorizontalLayout {
                padding: 4px;
                spacing: 8px;
                ControlKnob { group: g; key: "vary"; label: "VARY"; size: 26px; }
                Text { text: "Lets the groove change by itself:\nweak hits drop out, ghost notes\ncome in, hits waver in loudness."; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Text { x: 8px; height: 22px; text: track > 0 ? "This mapped role, on the next bar" : "Every unlocked track, on the next bar"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
            GrooveDiceItems { g: g; track: track; }
            Rectangle { height: 1px; background: Theme.border; }
            GrooveMenuItem {
                text: can-undo ? "Undo" : "Nothing to undo";
                clicked => { Controls.set-value(Controls.resolve(g, "dice_undo"), 1); }
            }
        }
    }
}


export component GrooveLibraryBar inherits HorizontalLayout {
    in property <int> deck;
    in property <bool> compact;
    in property <string> native-group;
    in property <string> target-name;
    in property <length> control-height: 30px;
    in property <string> g;
    in property <color> tint;
    property <int> kit-index: Controls.resolve(g, "kit");
    property <int> kit: Controls.value(kit-index, Controls.tick);
    property <int> genre-index: Controls.resolve(g, "genre");
    property <int> genre: Controls.value(genre-index, Controls.tick);
    property <int> pattern-index: Controls.resolve(g, "pattern");
    property <int> pattern: Controls.value(pattern-index, Controls.tick);
    property <int> chain-index: Controls.resolve(g, "chain");
    property <int> chain: Controls.value(chain-index, Controls.tick);
    property <[GrooveName]> grooves: GrooveUi.genres[genre].grooves;
    spacing: 4px;
            PerformanceButton {
                width: root.compact ? 64px : 76px;
                height: root.control-height;
                text: GrooveUi.kits[kit].name + " ▾";
                clicked => { kit-menu.show(); }
                kit-menu := PopupWindow {
                    y: parent.height + 2px;
                    width: 260px;
                    GrooveMenuBackground { }
                    VerticalLayout {
                        padding: 4px;
                        if native-group != "": Text { text: "Load rhythm kit · " + target-name + " · Sounds 1–8"; color: Theme.text-dim; font-size: 10px; height: 26px; }
                        for k[i] in GrooveUi.kits: GrooveMenuItem {
                            text: k.name;
                            detail: k.about;
                            checked: i == kit;
                            clicked => {
                                Controls.set-value(kit-index, i);
                                if native-group != "" { Controls.set-value(Controls.resolve(native-group, "rhythm_load_kit"), 1); }
                            }
                        }
                    }
                }
            }
            PerformanceButton {
                width: root.compact ? 54px : 60px;
                height: root.control-height;
                text: GrooveUi.genres[genre].name + " ▾";
                clicked => { genre-menu.show(); }
                genre-menu := PopupWindow {
                    y: parent.height + 2px;
                    width: 190px;
                    height: min(GrooveUi.genres.length * 24px + 8px, 340px);
                    GrooveMenuBackground { }
                    ListView {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        for item[i] in GrooveUi.genres: GrooveMenuItem {
                            text: item.name;
                            checked: i == genre;
                            // A new genre starts on its first groove, unchained.
                            clicked => {
                                Controls.set-value(genre-index, i);
                                Controls.set-value(pattern-index, 1);
                                Controls.set-value(chain-index, 0);
                                Controls.set-value(Controls.resolve(g, "load"), 1);
                            }
                        }
                    }
                }
            }
            // The groove's name takes the room left over.
            PerformanceButton {
                min-width: 34px;
                horizontal-stretch: 1;
                height: root.control-height;
                text: (pattern > 0 && pattern <= grooves.length ? grooves[pattern - 1].name : "Groove") + " ▾";
                clicked => { pattern-menu.show(); }
                pattern-menu := PopupWindow {
                    y: parent.height + 2px;
                    width: 300px;
                    height: min(grooves.length * 36px + 8px, 380px);
                    GrooveMenuBackground { }
                    ListView {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        for item[i] in grooves: GrooveMenuItem {
                            text: item.name;
                            detail: item.about;
                            checked: i + 1 == pattern;
                            clicked => {
                                Controls.set-value(pattern-index, i + 1);
                                Controls.set-value(Controls.resolve(g, "load"), 1);
                            }
                        }
                    }
                }
            }
            PerformanceButton {
                width: root.compact ? 48px : 52px;
                height: root.control-height;
                text: "Chain ▾";
                lit: chain > 0;
                tint: tint;
                clicked => { chain-menu.show(); }
                chain-menu := PopupWindow {
                    y: parent.height + 2px;
                    width: 220px;
                    height: min((grooves.length + 1) * 24px + 8px, 340px);
                    GrooveMenuBackground { }
                    ScrollView {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        VerticalLayout {
                            GrooveMenuItem {
                                text: "Off";
                                checked: chain == 0;
                                clicked => { Controls.set-value(chain-index, 0); }
                            }
                            // The groove picked and this one take turns, a bar each.
                            for item[i] in grooves: GrooveMenuItem {
                                text: item.name;
                                checked: i + 1 == chain;
                                clicked => {
                                    Controls.set-value(chain-index, i + 1);
                                    Controls.set-value(Controls.resolve(g, "load_chain"), 1);
                                }
                            }
                        }
                    }
                }
            }
            // The preset shares the room left over with the groove's name.
            GroovePreset { deck: deck; min-width: 34px; horizontal-stretch: 1; height: root.control-height; tint: tint; }
}

// The original A–D selector, shared by both Groove frontends.
export component GrooveSlots inherits HorizontalLayout {
    in property <string> g;
    in property <color> tint;
    in property <length> control-height: 30px;
    property <int> sounding: Controls.value(Controls.resolve(g, "groove_playing"), Controls.tick);
    property <int> queued: Controls.value(Controls.resolve(g, "groove_queued"), Controls.tick);
    spacing: 4px;
    for letter[i] in ["A", "B", "C", "D"]: PerformanceButton {
        width: 22px; height: control-height;
        text: letter; tint: tint;
        lit: i == sounding;
        blink: i == queued && queued != sounding && Controls.blink;
        clicked => { Controls.set-value(Controls.resolve(g, "groove"), i); }
    }
}
