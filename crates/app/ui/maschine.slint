import { Theme } from "theme.slint";
import { Controls, ControlButton } from "controls.slint";
import { GrooveTempo, GrooveFillBar, PerformanceStatus, GrooveDice, GrooveLibraryBar, GrooveSlots, GrooveMenuBackground, GrooveMenuItem } from "performance.slint";
import { ListView, ScrollView } from "scroll.slint";

export struct MaschineGroup {
    name: string,
    color: color,
    cue: bool,
    muted: bool,
    playing: bool,
    assigned-pattern-name: string,
    sound-loaded: int,
}

export struct MaschineSound {
    name: string,
    instrument: string,
    color: color,
    loaded: bool,
    muted: bool,
    base-key: int,
}

export struct MaschinePattern {
    name: string,
    detail: string,
}

export struct MaschineScene {
    name: string,
    references: string,
}

export struct MaschineNote {
    index: int,
    sound: int,
    pitch: int,
    start: float,
    length: float,
    velocity: int,
    probability: int,
}

export struct MaschineParam {
    name: string,
    display: string,
    value: float,
    enabled: bool,
}

export struct MaschineInstrument {
    name: string,
    detail: string,
}

export struct MaschineBrowserItem { name: string, favorite: bool }
export struct MaschineBrowserFilter { options: [string], current: int }

// Views come from the embedded DECKARD document. Edits return to that document.
export global MaschineUi {
    in-out property <bool> show-pads: true;
    in-out property <bool> show-editor: true;
    in-out property <bool> show-parameters: true;
    in-out property <bool> show-browser: false;
    in-out property <bool> show-performance: true;
    callback view-change(panel: string);
    in property <[int]> rhythm-roles;
    in property <bool> rhythm-map-valid;
    in property <bool> rhythm-map-changed;
    in property <int> rhythm-edit-group: -1;
    callback rhythm-edit(group: int);
    callback rhythm-role(role: int, sound: int);
    callback rhythm-apply(group: int);
    in property <string> project-name;
    in property <string> status;
    in property <[MaschineGroup]> groups;
    in property <[MaschineSound]> sounds;
    in property <[MaschinePattern]> patterns;
    in property <int> assigned-pattern: -1;
    in property <string> assigned-pattern-name;
    in property <[MaschineScene]> scenes;
    in property <[MaschineNote]> notes;
    in property <[MaschineParam]> parameters;
    in property <[MaschineInstrument]> instruments;
    in property <string> selected-instrument-name;
    in property <[MaschineBrowserItem]> browser-results;
    in property <[MaschineBrowserFilter]> browser-filters;
    in property <int> browser-focus;
    in property <int> browser-kind;
    in property <bool> browser-favorites;
    in property <bool> browser-busy;
    in property <bool> browser-user;
    in property <float> pattern-beats: 4;
    in property <string> selected-sound-name;
    in property <string> parameter-page;
    in property <string> sample-name;
    in property <string> sample-origin;
    in property <image> sample-waveform;
    in property <float> sample-start;
    in property <float> sample-end: 1;
    in property <float> sample-loop-start;
    in property <float> sample-loop-end: 1;
    in property <bool> sample-loop;
    in property <bool> sample-loaded;
    in property <bool> sample-staged;
    in property <int> sample-slice-count;
    in property <int> sample-selected-slice;
    in-out property <bool> sample-stage-to-group: true;
    in-out property <bool> sample-replace-occupied;
    callback sample-preview(slice: int);
    in property <string> sound-launch-mode;
    in property <bool> sound-launch-audio;
    in property <float> sound-launch-bars;
    in property <int> sound-launch-audio-mode;
    in property <int> sound-launch-audio-engine: 1;
    callback sound-launch(action: string);
    in property <float> sample-gain: 1;
    in property <float> sample-pitch;
    in property <float> sample-fade-in;
    in property <float> sample-fade-out;
    in-out property <int> sample-slice-mode: 0;
    in property <[float]> sample-markers;
    in-out property <int> context: 0;
    in-out property <bool> editing-note;
    in-out property <bool> instrument-menu-open;
    in property <bool> content-import-busy;
    in property <string> content-import-report: "Choose a native-recipes.json content bank to install kits, projects and patterns. Installed sounds appear in Instruments → Presets → Groove Box.";
    in property <string> harmony-label: "CHROMATIC";
    in property <string> harmony-detail;
    in property <string> harmony-key1: "?";
    in property <string> harmony-key2: "?";
    in property <string> harmony-transition;
    in property <string> harmony-common-notes;
    in property <bool> harmony-selected-active;
    pure callback harmonic-note(pitch: int, mask: int) -> bool;
    pure callback harmonic-pitch(pitch: int, mask: int, mapped: bool) -> int;
    callback adopt-key(deck: int);
    callback import-content();
    callback open-project();
    callback save-project();
    callback pick-pattern(pattern: int);
    callback edit-pattern(pattern: int);
    callback toggle-group-pattern();
    callback add-pattern();
    callback add-scene();
    callback add-note(sound: int, pitch: int, start: float, length: float);
    callback edit-note(index: int, start: float, length: float, pitch: int, sound: int);
    callback delete-note(index: int);
    callback note-velocity(index: int, velocity: int);
    callback set-parameter(knob: int, value: float);
    callback parameter-page-step(by: int);
    callback sample-action(action: string);
    callback sample-range(start: float, end: float);
    callback sample-capture(source-deck: int, stem: int, bars: int, slice: int);
    callback sample-edit(field: string, value: float);
    callback sample-cancel();
    callback sample-marker(position: float);
    callback load-instrument(index: int);
    callback browser-kind-pick(kind: int);
    callback browser-filter(which: int, index: int);
    callback browser-focus-result(index: int, load: bool);
    callback browser-action(action: string);
    callback pad-calibration(key: string, value: float);
    callback encoder-calibration(action: string);
    pure callback pad-curve-value(input: int, curve: int, gain: float, fixed: int) -> float;
}

component MaschineButton inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <color> tint: Theme.deck3;
    callback clicked();
    min-width: 26px;
    height: 26px;
    border-radius: 4px;
    border-width: 1px;
    border-color: on ? tint : Theme.border;
    background: on ? tint.with-alpha(0.18) : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.panel-raised.brighter(0.2) : Theme.control;
    opacity: enabled ? 1 : 0.35;
    Text {
        x: 5px;
        width: parent.width - 10px;
        text: root.text;
        color: on ? tint : Theme.text;
        font-size: 10px;
        font-weight: 600;
        overflow: elide;
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

component MaschineKnob inherits Rectangle {
    in property <MaschineParam> parameter;
    in property <color> tint;
    callback changed(value: float);
    property <float> drag-start;
    property <angle> at: (-135 + parameter.value * 270) * 1deg;
    opacity: parameter.enabled ? 1 : 0.35;
    VerticalLayout {
        spacing: 1px;
        Text { text: parameter.name; color: Theme.text-dim; font-size: 9px; horizontal-alignment: center; overflow: elide; height: 12px; }
        Rectangle {
            width: 26px;
            height: 26px;
            x: (parent.width - self.width) / 2;
            border-radius: 13px;
            border-width: 1px;
            border-color: Theme.border;
            background: ta.has-hover ? Theme.n-44464b : Theme.n-2b2d31;
            Path {
                width: 26px;
                height: 26px;
                viewbox-width: 26;
                viewbox-height: 26;
                stroke: tint;
                stroke-width: 2px;
                stroke-line-cap: round;
                MoveTo { x: 13 + 3 * sin(at); y: 13 - 3 * cos(at); }
                LineTo { x: 13 + 10 * sin(at); y: 13 - 10 * cos(at); }
            }
        }
        Text { text: parameter.display; color: Theme.text; font-size: 9px; horizontal-alignment: center; overflow: elide; height: 12px; }
    }
    ta := TouchArea {
        enabled: parameter.enabled;
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { drag-start = parameter.value; }
        }
        moved => {
            if self.pressed { root.changed(clamp(drag-start + (self.pressed-y - self.mouse-y) / 160px, 0, 1)); }
        }
        scroll-event(e) => {
            root.changed(clamp(parameter.value + (e.delta-y > 0 ? 0.01 : -0.01), 0, 1));
            accept
        }
    }
}

component HarmonicTools inherits Rectangle {
    in property <string> group;
    in property <color> tint;
    property <int> mode: Controls.value(Controls.resolve(group, "harmony_mode"), Controls.tick);
    property <int> leader: Controls.value(Controls.resolve(group, "harmony_leader"), Controls.tick);
    property <int> tonic: Controls.value(Controls.resolve(group, "harmony_root"), Controls.tick);
    property <int> scale: Controls.value(Controls.resolve(group, "harmony_scale"), Controls.tick);
    background: Theme.panel-raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 10px;
        spacing: 7px;
        Text { text: "KEYBOARD / PIANO ROLL"; color: Theme.text; font-size: 12px; font-weight: 600; height: 18px; }
        HorizontalLayout {
            spacing: 4px;
            for label[i] in ["CHROMATIC", "AUTO", "MANUAL", "COMMON"]: MaschineButton {
                text: label; on: root.mode == i; tint: root.tint; horizontal-stretch: 1;
                clicked => { Controls.set-value(Controls.resolve(group, "harmony_mode"), i); }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Text { text: "Follow"; color: Theme.text-dim; font-size: 10px; width: 42px; vertical-alignment: center; }
            for label[i] in ["LEADER", "DECK 1", "DECK 2", "DECK 4"]: MaschineButton {
                text: label; on: root.mode == 1 && root.leader == (i == 3 ? 4 : i); tint: root.tint; horizontal-stretch: 1;
                clicked => {
                    Controls.set-value(Controls.resolve(group, "harmony_leader"), i == 3 ? 4 : i);
                    Controls.set-value(Controls.resolve(group, "harmony_mode"), 1);
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            for label[i] in ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"]: MaschineButton {
                text: label; on: root.mode == 2 && root.tonic == i; tint: root.tint; horizontal-stretch: 1;
                clicked => {
                    Controls.set-value(Controls.resolve(group, "harmony_root"), i);
                    Controls.set-value(Controls.resolve(group, "harmony_mode"), 2);
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            for label[i] in ["MAJOR", "MINOR", "MAJ PENTA", "MIN PENTA"]: MaschineButton {
                text: label; on: root.mode == 2 && root.scale == i; tint: root.tint; horizontal-stretch: 1;
                clicked => {
                    Controls.set-value(Controls.resolve(group, "harmony_scale"), i);
                    Controls.set-value(Controls.resolve(group, "harmony_mode"), 2);
                }
            }
        }
        Text { text: MaschineUi.harmony-label; color: root.tint; font-size: 14px; font-weight: 600; height: 20px; }
        Text { text: MaschineUi.harmony-detail; color: Theme.text; font-size: 10px; wrap: word-wrap; height: 44px; }
        ControlButton { group: group; key: "harmony_samples"; text: "MAP SAMPLES · opt in for pitched Sampler / Audio"; height: 26px; font-size: 10px; tint: root.tint; }
        Text { text: "Mapping applies to new melodic notes and pitch edits."; color: Theme.text-dim; font-size: 10px; height: 16px; }
        Rectangle { height: 1px; background: Theme.border; }
        Text { text: "TRANSITION · DECK 1 → DECK 2"; color: Theme.text; font-size: 12px; font-weight: 600; height: 18px; }
        Text { text: MaschineUi.harmony-key1 + " → " + MaschineUi.harmony-key2; color: root.tint; font-size: 13px; height: 20px; }
        Text { text: MaschineUi.harmony-transition; color: Theme.text; font-size: 10px; wrap: word-wrap; height: 34px; }
        Text { text: "Shared notes · " + MaschineUi.harmony-common-notes; color: Theme.text-dim; font-size: 10px; wrap: word-wrap; height: 24px; }
        HorizontalLayout {
            spacing: 4px;
            MaschineButton { text: "ADOPT KEY 1"; horizontal-stretch: 1; enabled: MaschineUi.harmony-key1 != "?"; clicked => { MaschineUi.adopt-key(1); } }
            MaschineButton { text: "ADOPT KEY 2"; horizontal-stretch: 1; enabled: MaschineUi.harmony-key2 != "?"; clicked => { MaschineUi.adopt-key(2); } }
            MaschineButton { text: "SHARED NOTES"; horizontal-stretch: 1; enabled: MaschineUi.harmony-key1 != "?" && MaschineUi.harmony-key2 != "?"; clicked => { Controls.set-value(Controls.resolve(group, "harmony_mode"), 3); } }
        }
        Text { text: "Wheel and scale guidance · audition the bass and chord voicing."; color: Theme.text-dim; font-size: 10px; wrap: word-wrap; height: 22px; }
    }
}

component EncoderCalibration inherits Rectangle {
    callback close();
    in property <color> tint: Theme.deck3;
    property <string> g: "[MaschineEncoders]";
    property <int> knobs: Controls.value(Controls.resolve(g, "knob_counts"), Controls.tick);
    property <int> wheel: Controls.value(Controls.resolve(g, "wheel_counts"), Controls.tick);
    property <int> measure: Controls.value(Controls.resolve(g, "measure"), Controls.tick);
    property <bool> knob-measured: Controls.value(Controls.resolve(g, "knob_measured"), Controls.tick) > 0;
    property <bool> wheel-measured: Controls.value(Controls.resolve(g, "wheel_measured"), Controls.tick) > 0;
    property <int> measured: Controls.value(Controls.resolve(g, "measured"), Controls.tick);
    property <int> encoder: Controls.value(Controls.resolve(g, "measured_encoder"), Controls.tick);
    background: Theme.panel;
    border-width: 1px; border-color: Theme.border; border-radius: 6px;
    VerticalLayout {
        padding: 12px; spacing: 8px;
        Text { text: "Resposta angular · Maschine MK2"; color: Theme.text; font-size: 13px; font-weight: 600; }
        Text { text: "Opções 45° · contínuos 270° · SHIFT 10× mais fino"; color: Theme.text; font-size: 11px; }
        Text { text: "Knobs " + knobs + (knob-measured ? " medidos" : " padrão") + " · encoder " + wheel + (wheel-measured ? " medidos" : " padrão") + " pulsos/360°"; color: Theme.text; font-size: 11px; }
        Text { text: "Padrões derivados do bridge. Calibre com uma volta física completa."; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 6px;
            MaschineButton { text: "MEDIR KNOB 360°"; horizontal-stretch: 1; clicked => { MaschineUi.encoder-calibration("knob"); } }
            MaschineButton { text: "MEDIR ENCODER 360°"; horizontal-stretch: 1; clicked => { MaschineUi.encoder-calibration("wheel"); } }
        }
        Text { text: measure == 0 ? "Escolha o controle para iniciar a medição." : "Gire um único controle 360° no mesmo sentido. " + abs(measured) + " pulsos · CC " + encoder; color: tint; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 6px;
            MaschineButton { text: "SALVAR VOLTA"; enabled: measure > 0 && abs(measured) >= 16 && abs(measured) <= 4096; horizontal-stretch: 1; clicked => { MaschineUi.encoder-calibration("save"); } }
            MaschineButton { text: "CANCELAR"; horizontal-stretch: 1; clicked => { MaschineUi.encoder-calibration("cancel"); } }
        }
        HorizontalLayout {
            spacing: 6px;
            MaschineButton { text: "RESTAURAR PADRÕES"; horizontal-stretch: 1; clicked => { MaschineUi.encoder-calibration("reset"); } }
            MaschineButton { text: "FECHAR"; width: 70px; clicked => { MaschineUi.encoder-calibration("cancel"); root.close(); } }
        }
    }
}

component PadCalibration inherits Rectangle {
    in property <color> tint: Theme.deck3;
    property <string> g: "[MaschinePads]";
    property <int> curve: Controls.value(Controls.resolve(g, "curve"), Controls.tick);
    property <float> gain: Controls.value(Controls.resolve(g, "sensitivity"), Controls.tick);
    property <int> fixed: Controls.value(Controls.resolve(g, "fixed"), Controls.tick);
    property <int> last-pad: Controls.value(Controls.resolve(g, "last_pad"), Controls.tick);
    property <int> last-input: Controls.value(Controls.resolve(g, "last_input"), Controls.tick);
    property <int> last-output: Controls.value(Controls.resolve(g, "last_output"), Controls.tick);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;
    VerticalLayout {
        padding: 10px;
        spacing: 7px;
        Text { text: "Resposta dos pads · Maschine MK2"; color: Theme.text; font-size: 13px; font-weight: 600; height: 20px; }
        HorizontalLayout {
            spacing: 4px;
            for label[i] in ["Linear", "Suave", "Firme", "Fixa"]: MaschineButton {
                text: label; horizontal-stretch: 1; on: root.curve == i; tint: root.tint;
                clicked => { MaschineUi.pad-calibration("curve", i); }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                height: 88px;
                background: Theme.control;
                border-width: 1px;
                border-color: Theme.border;
                for quarter in 3: Rectangle { y: (quarter + 1) * parent.height / 4; width: parent.width; height: 1px; background: Theme.border; }
                for i in 64: Rectangle {
                    x: i * parent.width / 64;
                    width: max(1px, parent.width / 64 - 1px);
                    height: MaschineUi.pad-curve-value(round((i + 1) * 127 / 64), root.curve, root.gain, root.fixed) * parent.height;
                    y: parent.height - self.height;
                    background: root.tint;
                }
            }
            MaschineKnob {
                width: 85px;
                parameter: {name: "Sensibilidade", display: round(root.gain * 100) + "%", value: (root.gain - 0.25) / 3.75, enabled: root.curve != 3};
                tint: root.tint;
                changed(value) => { MaschineUi.pad-calibration("sensitivity", 0.25 + value * 3.75); }
            }
            if root.curve == 3: MaschineKnob {
                width: 65px;
                parameter: {name: "Velocidade", display: root.fixed, value: (root.fixed - 1) / 126, enabled: true};
                tint: root.tint;
                changed(value) => { MaschineUi.pad-calibration("fixed", round(1 + value * 126)); }
            }
        }
        Text { text: root.last-pad > 0 ? "Pad " + root.last-pad + " · entrada MIDI " + root.last-input + " → " + root.last-output : "Toque um pad para medir a resposta"; color: Theme.text; font-size: 11px; height: 18px; }
        for value[i] in [root.last-input, root.last-output]: Rectangle {
            height: 12px;
            background: Theme.control;
            Rectangle { width: value / 127 * parent.width; height: parent.height; background: i == 0 ? Theme.text-dim : root.tint; }
        }
        MaschineButton {
            text: "Usar este toque como volume máximo";
            enabled: root.last-input > 0 && root.curve != 3;
            tint: root.tint;
            clicked => { MaschineUi.pad-calibration("match", 0); }
        }
        HorizontalLayout {
            spacing: 5px;
            MaschineButton { text: "Limpar medição"; horizontal-stretch: 1; clicked => { MaschineUi.pad-calibration("clear", 0); } }
            MaschineButton { text: "Restaurar · suave 150%"; horizontal-stretch: 1; clicked => { MaschineUi.pad-calibration("reset", 0); } }
        }
    }
}

component MaschinePads inherits Rectangle {
    in property <string> group;
    in property <int> selected-group;
    in property <int> sound;
    in property <color> tint;
    property <bool> keyboard: Controls.value(Controls.resolve(group, "keyboard"), Controls.tick) > 0;
    property <int> octave: Controls.value(Controls.resolve(group, "octave"), Controls.tick);
    property <int> semitone: Controls.value(Controls.resolve(group, "semitone"), Controls.tick);
    property <int> harmonic-mask: Controls.value(Controls.resolve(group, "harmony_mask"), Controls.tick);
    for slot in 16: Rectangle {
        // Maschine's pad 1 starts at the lower left.
        property <int> pad: (3 - floor(slot / 4)) * 4 + Math.mod(slot, 4);
        property <MaschineSound> item: MaschineUi.sounds[root.keyboard ? root.sound : pad];
        property <int> pitch: MaschineUi.harmonic-pitch(clamp(60 + pad + root.octave * 12 + root.semitone, 0, 127), root.harmonic-mask, MaschineUi.harmony-selected-active);
        property <int> pad-index: Controls.resolve(group, "pad" + (pad + 1));
        property <bool> held: Controls.value(pad-index, Controls.tick) > 0;
        property <float> level: Controls.value(Controls.resolve(group, "group" + (selected-group + 1) + "_sound" + (pad + 1) + "_meter"), Controls.tick);
        x: Math.mod(slot, 4) * parent.width / 4;
        y: floor(slot / 4) * parent.height / 4;
        width: parent.width / 4 - 4px;
        height: parent.height / 4 - 4px;
        border-radius: 5px;
        border-width: pad == sound || held ? 2px : 1px;
        border-color: held ? Theme.text : pad == sound ? tint : item.color.with-alpha(0.7);
        background: held ? item.color.with-alpha(0.5) : pad == sound ? tint.with-alpha(0.16) : Theme.well;
        VerticalLayout {
            padding: 4px;
            spacing: 2px;
            HorizontalLayout {
                height: 12px;
                Text { text: pad + 1; color: item.loaded ? item.color : Theme.text-dim; font-size: 9px; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                if item.muted: Text { text: "M"; color: Theme.c-ff9f0a; font-size: 9px; }
            }
            Text { text: root.keyboard ? ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"][Math.mod(pitch, 12)] + (floor(pitch / 12) - 2) : item.name; color: item.loaded ? Theme.text : Theme.text-dim; font-size: 9px; overflow: elide; vertical-stretch: 1; vertical-alignment: bottom; }
        }
        Rectangle { x: 3px; y: parent.height - 4px; width: clamp(level, 0, 1) * (parent.width - 6px); height: 2px; background: item.color; }
        TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    if !root.keyboard { Controls.set-value(Controls.resolve(group, "sound"), pad); }
                    Controls.set-value(pad-index, 1);
                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    Controls.set-value(pad-index, 0);
                }
            }
        }
    }
}

component MaschineNotes inherits Rectangle {
    in property <bool> piano;
    in property <int> sound;
    in property <color> tint;
    in property <float> position;
    in property <bool> playing;
    in-out property <int> pitch-low: 48;
    property <int> rows: piano ? 24 : 16;
    property <float> beats: max(1, MaschineUi.pattern-beats);
    property <int> selected-note: -1;
    property <int> harmonic-mask: Controls.value(Controls.resolve("[Maschine3]", "harmony_mask"), Controls.tick);
    background: Theme.well;
    clip: true;
    Rectangle {
        x: 0;
        y: 18px;
        width: 49px;
        height: parent.height - 18px;
        for row in root.rows: Rectangle {
            y: row * parent.height / root.rows;
            height: parent.height / root.rows;
            width: parent.width;
            property <int> pitch: root.pitch-low + root.rows - 1 - row;
            property <int> key: Math.mod(pitch, 12);
            background: piano && (key == 1 || key == 3 || key == 6 || key == 8 || key == 10) ? Theme.n-292b30 : row == sound && !piano ? tint.with-alpha(0.15) : Theme.panel;
            border-width: 0.5px;
            border-color: Theme.separator;
            Text {
                x: 3px;
                width: parent.width - 6px;
                text: piano ? ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"][key] + (floor(pitch / 12) - 2) : (row + 1) + " " + MaschineUi.sounds[row].name;
                color: piano && MaschineUi.harmony-selected-active && MaschineUi.harmonic-note(pitch, harmonic-mask) ? tint : piano && key == 0 ? tint : Theme.text-dim;
                font-size: min(10px, parent.height - 1px);
                overflow: elide;
            }
        }
    }
    grid := Rectangle {
        x: 50px;
        y: 18px;
        width: parent.width - 50px;
        height: parent.height - 18px;
        for step in ceil(beats * 4) + 1: Rectangle {
            x: step / (beats * 4) * parent.width;
            width: 1px;
            height: parent.height;
            background: Math.mod(step, 16) == 0 ? Theme.n-ffffff26 : Math.mod(step, 4) == 0 ? Theme.n-ffffff16 : Theme.n-ffffff08;
        }
        for row in root.rows + 1: Rectangle {
            y: row * parent.height / root.rows;
            height: 1px;
            background: Theme.n-ffffff0c;
        }
        TouchArea {
            mouse-cursor: crosshair;
            double-clicked => {
                let row = clamp(floor(self.mouse-y / self.height * root.rows), 0, root.rows - 1);
                let at = floor(self.mouse-x / self.width * beats * 4) / 4;
                MaschineUi.add-note(piano ? sound : row, piano ? pitch-low + root.rows - 1 - row : MaschineUi.sounds[row].base-key, at, 0.25);
            }
        }
        for note in MaschineUi.notes: Rectangle {
            visible: (!piano || note.sound == sound) && (!piano || (note.pitch >= pitch-low && note.pitch < pitch-low + root.rows));
            x: (ta.pressed ? moved-start : note.start) / beats * parent.width;
            y: (piano ? root.rows - 1 - ((ta.pressed ? moved-pitch : note.pitch) - pitch-low) : (ta.pressed ? moved-sound : note.sound)) * parent.height / root.rows + 1px;
            width: max(3px, (ta.pressed ? moved-length : note.length) / beats * parent.width - 1px);
            height: max(2px, parent.height / root.rows - 2px);
            border-radius: 2px;
            border-width: note.index == selected-note ? 1px : 0px;
            border-color: Theme.text;
            background: (piano ? tint : MaschineUi.sounds[note.sound].color).with-alpha(0.3 + note.velocity / 127 * 0.7);
            property <float> moved-start;
            property <float> moved-length;
            property <int> moved-pitch;
            property <int> moved-sound;
            property <length> press-grid-x;
            property <length> press-grid-y;
            property <bool> resize;
            ta := TouchArea {
                mouse-cursor: self.mouse-x > self.width - 6px ? ew-resize : move;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                        MaschineUi.delete-note(note.index);
                    } else if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        MaschineUi.editing-note = true;
                        selected-note = note.index;
                        resize = self.mouse-x > self.width - 6px;
                        moved-start = note.start;
                        moved-length = note.length;
                        moved-pitch = note.pitch;
                        moved-sound = note.sound;
                        press-grid-x = self.absolute-position.x + self.mouse-x - grid.absolute-position.x;
                        press-grid-y = self.absolute-position.y + self.mouse-y - grid.absolute-position.y;
                    } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                        MaschineUi.edit-note(note.index, moved-start, moved-length, moved-pitch, moved-sound);
                        MaschineUi.editing-note = false;
                    } else if e.kind == PointerEventKind.cancel {
                        MaschineUi.editing-note = false;
                    }
                }
                moved => {
                    if self.pressed {
                        let delta-x = self.absolute-position.x + self.mouse-x - grid.absolute-position.x - press-grid-x;
                        let delta-y = self.absolute-position.y + self.mouse-y - grid.absolute-position.y - press-grid-y;
                        let delta = round(delta-x / grid.width * beats * 4) / 4;
                        if resize { moved-length = max(0.25, note.length + delta); }
                        else {
                            moved-start = clamp(note.start + delta, 0, max(0, beats - note.length));
                            moved-pitch = piano ? clamp(note.pitch - round(delta-y / grid.height * root.rows), 0, 127) : note.pitch;
                            moved-sound = piano ? note.sound : clamp(note.sound + round(delta-y / grid.height * root.rows), 0, 15);
                        }
                    }
                }
                scroll-event(e) => {
                    MaschineUi.note-velocity(note.index, clamp(note.velocity + (e.delta-y > 0 ? 1 : -1), 1, 127));
                    accept
                }
            }
            if note.probability < 100: Rectangle { y: parent.height - 2px; height: 2px; width: parent.width * note.probability / 100; background: Theme.text.with-alpha(0.7); }
        }
        if playing: Rectangle { x: Math.mod(position / 960, beats) / beats * parent.width; width: 1px; height: parent.height; background: Theme.text; }
    }
    for beat in ceil(beats): Text {
        x: 50px + beat / beats * grid.width + 3px;
        height: 16px;
        text: Math.mod(beat, 4) == 0 ? floor(beat / 4) + 1 : "·";
        color: Theme.text-dim;
        font-size: 9px;
    }
}

component MaschineSampling inherits Rectangle {
    in property <color> tint;
    property <int> source-deck: 0;
    property <int> stem: 0;
    property <int> bars-index: 2;
    property <int> slice: 1;
    property <bool> edit-mode;
    property <bool> edit-markers: true;
    background: Theme.well;
    sampling-scroll := ScrollView {
        content-width: self.visible-width;
        content-height: sampling-content.preferred-height;
        sampling-content := VerticalLayout {
        width: sampling-scroll.visible-width;
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            height: 24px;
            Text { text: MaschineUi.sample-name; color: Theme.text; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            MaschineButton { text: "LOAD"; width: 46px; clicked => { MaschineUi.sample-action("load"); } }
            MaschineButton { text: "CAPTURE"; width: 56px; on: !edit-mode; clicked => { edit-mode = false; } }
            MaschineButton { text: "EDIT"; width: 38px; on: edit-mode; clicked => { edit-mode = true; } }
        }
        if MaschineUi.sound-launch-mode != "" || MaschineUi.sound-launch-audio: MaschineButton {
            height: 24px;
            text: "LAUNCH · " + (MaschineUi.sound-launch-audio ? (MaschineUi.sound-launch-audio-mode == 0 ? "Pattern loop" : "Pattern gate") :
                MaschineUi.sound-launch-mode == "poly" ? "One-shot poly" :
                MaschineUi.sound-launch-mode == "retrigger" ? "Retrigger" :
                MaschineUi.sound-launch-mode == "gate" ? "Gate" :
                MaschineUi.sound-launch-mode == "loop" ? "Loop held" : "Custom") + " ▾";
            clicked => { launch-options.show(); }
        }
        if !edit-mode: HorizontalLayout {
            height: 24px;
            spacing: 4px;
            MaschineButton { text: source-deck == 4 ? "Master mix" : "Deck " + (source-deck + 1); horizontal-stretch: 1; clicked => { source-deck = Math.mod(source-deck + 1, 5); Controls.set-value(Controls.resolve("[Maschine3]", "sampling_source"), source-deck); } }
            MaschineButton { text: ["Mix · FX", "Drums · pre FX", "Bass · pre FX", "Melody · pre FX", "Voice · pre FX"][stem]; horizontal-stretch: 1; clicked => { stem = Math.mod(stem + 1, 5); Controls.set-value(Controls.resolve("[Maschine3]", "sampling_stem"), stem); } }
            MaschineButton { text: ([1, 2, 4, 8, 16][bars-index] * 4) + " beats"; horizontal-stretch: 1; clicked => { bars-index = Math.mod(bars-index + 1, 5); Controls.set-value(Controls.resolve("[Maschine3]", "sampling_bars"), [1, 2, 4, 8, 16][bars-index]); } }
        }
        if !edit-mode: HorizontalLayout {
            height: 24px;
            spacing: 4px;
            MaschineButton { text: ["Whole take", "Split · 16 pads", "Detect · up to 16", "Grid · 1 slice/beat"][slice]; horizontal-stretch: 1; clicked => { slice = Math.mod(slice + 1, 4); Controls.set-value(Controls.resolve("[Maschine3]", "sampling_slice"), slice); } }
            MaschineButton { text: "CAPTURE"; width: 68px; enabled: !MaschineUi.sample-staged; clicked => { MaschineUi.sample-capture(source-deck, stem, [1, 2, 4, 8, 16][bars-index], slice); } }
            MaschineButton { text: "×"; width: 26px; clicked => { MaschineUi.sample-cancel(); } }
        }
        if !edit-mode: HorizontalLayout {
            height: 24px; spacing: 4px;
            ControlButton { group: "[Maschine3]"; key: "sampling_next_bar"; text: "NEXT BAR"; horizontal-stretch: 1; }
            ControlButton { group: "[Maschine3]"; key: "sampling_monitor"; text: "MONITOR · CUE"; horizontal-stretch: 1; }
            Text { text: Controls.value(Controls.resolve("[Maschine3]", "sampling_recording"), Controls.tick) > 0 ? "REC " + round(100 * Controls.value(Controls.resolve("[Maschine3]", "sampling_progress"), Controls.tick)) + "%" : Controls.value(Controls.resolve("[Maschine3]", "sampling_waiting"), Controls.tick) > 0 ? "ARMED" : ""; color: Theme.text; font-size: 10px; vertical-alignment: center; }
        }
        if MaschineUi.sample-staged || Controls.value(Controls.resolve("[Maschine3]", "sampling_recording"), Controls.tick) > 0 || Controls.value(Controls.resolve("[Maschine3]", "sampling_waiting"), Controls.tick) > 0: Text {
            text: MaschineUi.sample-origin; height: 16px; color: Theme.text-dim; font-size: 10px; overflow: elide;
        }
        if MaschineUi.sample-staged: HorizontalLayout {
            height: 24px; spacing: 4px;
            MaschineButton { text: MaschineUi.sample-stage-to-group ? "☑ Stage to Group · all slices" : "☐ Stage to Group · selected slice"; horizontal-stretch: 1; clicked => { MaschineUi.sample-stage-to-group = !MaschineUi.sample-stage-to-group; } }
            MaschineButton { text: "DISCARD"; width: 62px; clicked => { MaschineUi.sample-action("DISCARD"); } }
        }
        if MaschineUi.sample-staged: HorizontalLayout {
            height: 24px; spacing: 4px;
            MaschineButton { text: MaschineUi.sample-replace-occupied ? "☑ Replace occupied · Undo" : "☐ Replace occupied · Undo"; horizontal-stretch: 1; clicked => { MaschineUi.sample-replace-occupied = !MaschineUi.sample-replace-occupied; } }
            MaschineButton { text: "APPLY → " + ["A", "B", "C", "D", "E", "F", "G", "H"][round(Controls.value(Controls.resolve("[Maschine3]", "group"), Controls.tick))] + " · CUE"; width: 106px; clicked => { MaschineUi.sample-action("APPLY"); } }
        }
        if MaschineUi.sample-staged: HorizontalLayout {
            height: 24px; spacing: 4px;
            MaschineButton { text: ["Split · 16", "Detect", "Manual", "Grid · beat"][MaschineUi.sample-slice-mode]; horizontal-stretch: 1; clicked => { MaschineUi.sample-slice-mode = Math.mod(MaschineUi.sample-slice-mode + 1, 4); MaschineUi.sample-action("RESLICE"); } }
            if MaschineUi.sample-slice-mode == 2: MaschineButton { text: edit-markers ? "MARK" : "RANGE"; width: 46px; clicked => { edit-markers = !edit-markers; } }
            MaschineButton { text: "◀"; width: 28px; clicked => { MaschineUi.sample-preview(Math.mod(MaschineUi.sample-selected-slice + MaschineUi.sample-slice-count - 1, max(1, MaschineUi.sample-slice-count))); } }
            Text { text: "Slice " + (MaschineUi.sample-selected-slice + 1) + "/" + MaschineUi.sample-slice-count; color: Theme.text; font-size: 10px; vertical-alignment: center; }
            MaschineButton { text: "▶"; width: 28px; clicked => { MaschineUi.sample-preview(Math.mod(MaschineUi.sample-selected-slice + 1, max(1, MaschineUi.sample-slice-count))); } }
        }
        HorizontalLayout {
            height: 24px; spacing: 4px;
            MaschineButton { text: "PREHEAR · CUE"; horizontal-stretch: 1; enabled: MaschineUi.sample-loaded; clicked => { MaschineUi.sample-preview(MaschineUi.sample-staged ? MaschineUi.sample-selected-slice : 0); } }
            MaschineButton { text: "STOP PREHEAR"; width: 100px; clicked => { MaschineUi.sample-action("STOP"); } }
        }
        if edit-mode || MaschineUi.sample-staged: HorizontalLayout {
            height: 54px;
            spacing: 4px;
            MaschineKnob {
                horizontal-stretch: 1; min-width: 0px; tint: tint;
                parameter: { name: "GAIN", display: round(MaschineUi.sample-gain * 100) + "%", value: MaschineUi.sample-gain / 2, enabled: MaschineUi.sample-loaded };
                changed(value) => { MaschineUi.sample-edit("gain", value * 2); }
            }
            MaschineKnob {
                horizontal-stretch: 1; min-width: 0px; tint: tint;
                parameter: { name: "PITCH", display: round(MaschineUi.sample-pitch) + " st", value: (MaschineUi.sample-pitch + 24) / 48, enabled: MaschineUi.sample-loaded };
                changed(value) => { MaschineUi.sample-edit("pitch", round(value * 48 - 24)); }
            }
            MaschineKnob {
                horizontal-stretch: 1; min-width: 0px; tint: tint;
                parameter: { name: "FADE IN", display: round(MaschineUi.sample-fade-in * 100) + "%", value: MaschineUi.sample-fade-in, enabled: MaschineUi.sample-loaded && !MaschineUi.sample-staged };
                changed(value) => { MaschineUi.sample-edit("fade-in", value); }
            }
            MaschineKnob {
                horizontal-stretch: 1; min-width: 0px; tint: tint;
                parameter: { name: "FADE OUT", display: round(MaschineUi.sample-fade-out * 100) + "%", value: MaschineUi.sample-fade-out, enabled: MaschineUi.sample-loaded && !MaschineUi.sample-staged };
                changed(value) => { MaschineUi.sample-edit("fade-out", value); }
            }
        }
        if edit-mode && !MaschineUi.sample-staged: HorizontalLayout {
            height: 24px;
            spacing: 4px;
            MaschineButton {
                text: ["Split · 16 Sounds", "Detect · up to 16 Sounds", "Manual · " + MaschineUi.sample-markers.length + "/17"][MaschineUi.sample-slice-mode];
                horizontal-stretch: 1;
                clicked => { MaschineUi.sample-slice-mode = Math.mod(MaschineUi.sample-slice-mode + 1, 3); }
            }
            if MaschineUi.sample-slice-mode == 2: MaschineButton { text: "CLEAR"; width: 44px; clicked => { MaschineUi.sample-action("clear-markers"); } }
        }
        if MaschineUi.sample-staged: Rectangle {
            height: 50px;
            for index in 16: MaschineButton {
                x: Math.mod(index, 8) * parent.width / 8;
                y: floor(index / 8) * 25px;
                width: parent.width / 8 - 2px; height: 23px;
                text: (index + 1) + "";
                enabled: index < MaschineUi.sample-slice-count;
                on: index == MaschineUi.sample-selected-slice;
                tint: root.tint;
                clicked => { MaschineUi.sample-preview(index); }
            }
        }
        Rectangle {
            height: 100px;
            clip: true;
            Image { width: parent.width; height: parent.height; source: MaschineUi.sample-waveform; image-fit: fill; }
            if MaschineUi.sample-loaded: Rectangle {
                x: MaschineUi.sample-start * parent.width;
                width: max(1px, (MaschineUi.sample-end - MaschineUi.sample-start) * parent.width);
                height: parent.height;
                background: tint.with-alpha(0.12);
                border-width: 1px;
                border-color: tint;
            }
            if !MaschineUi.sample-loaded: Text { text: "Load a sample into the selected Sound"; color: Theme.text-dim; font-size: 11px; }
            for marker in MaschineUi.sample-markers: Rectangle { x: marker * parent.width; width: 1px; height: parent.height; background: Theme.c-ffd60a; }
            property <float> range-start;
            TouchArea {
                enabled: MaschineUi.sample-loaded;
                mouse-cursor: crosshair;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        if (edit-mode || MaschineUi.sample-staged) && MaschineUi.sample-slice-mode == 2 && edit-markers { MaschineUi.sample-marker(clamp(self.mouse-x / self.width, 0, 1)); }
                        else { range-start = clamp(self.mouse-x / self.width, 0, 1); }
                    }
                    else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                        if (edit-mode || MaschineUi.sample-staged) && MaschineUi.sample-slice-mode == 2 && edit-markers { return; }
                        let end = clamp(self.mouse-x / self.width, 0, 1);
                        MaschineUi.sample-range(min(range-start, end), max(range-start, end));
                    }
                }
            }
        }
        if !MaschineUi.sample-staged: Rectangle {
            property <int> columns: root.width < 350px ? 2 : 4;
            height: root.width < 350px ? 56px : 26px;
            for action[i] in ["TRIM", "NORMALIZE", "REVERSE", "SLICE"]: MaschineButton {
                x: Math.mod(i, parent.columns) * parent.width / parent.columns;
                y: floor(i / parent.columns) * 30px;
                width: parent.width / parent.columns - 4px;
                text: action;
                enabled: MaschineUi.sample-loaded;
                clicked => { MaschineUi.sample-action(action); }
            }
        }
    }
    }
    launch-options := PopupWindow {
        x: 6px; y: 62px;
        width: max(200px, min(340px, root.width - 12px)); height: 210px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: 5px;
            border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 8px; spacing: 5px;
                HorizontalLayout {
                    height: 24px;
                    Text { text: MaschineUi.selected-sound-name; color: Theme.text; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    MaschineButton { text: "×"; width: 26px; clicked => { launch-options.close(); } }
                }
                if MaschineUi.sound-launch-mode != "": Rectangle {
                    height: 52px;
                    for label[i] in ["One-shot poly", "Retrigger", "Gate", "Loop held"]: MaschineButton {
                        x: Math.mod(i, 2) * parent.width / 2;
                        y: floor(i / 2) * 27px;
                        width: parent.width / 2 - 3px;
                        height: 24px;
                        text: label;
                        on: MaschineUi.sound-launch-mode == ["poly", "retrigger", "gate", "loop"][i];
                        clicked => { MaschineUi.sound-launch(["poly", "retrigger", "gate", "loop"][i]); }
                    }
                }
                if MaschineUi.sound-launch-mode != "": Text {
                    text: MaschineUi.sound-launch-mode == "poly" ? "Overlapping hits · selected Sound" :
                        MaschineUi.sound-launch-mode == "retrigger" ? "New hit restarts sample and cuts previous hit" :
                        MaschineUi.sound-launch-mode == "gate" ? "Plays while held · release closes gate" :
                        MaschineUi.sound-launch-mode == "loop" ? "Repeats loop range while held · new hit restarts" :
                        "Custom envelope / polyphony";
                    color: Theme.text-dim; font-size: 9px; wrap: word-wrap;
                }
                if MaschineUi.sound-launch-audio: HorizontalLayout {
                    height: 24px; spacing: 4px;
                    MaschineButton { text: "Pattern loop"; horizontal-stretch: 1; on: MaschineUi.sound-launch-audio-mode == 0; clicked => { MaschineUi.sound-launch("audio-loop"); } }
                    MaschineButton { text: "Pattern gate"; horizontal-stretch: 1; on: MaschineUi.sound-launch-audio-mode == 1; clicked => { MaschineUi.sound-launch("audio-gate"); } }
                }
                if MaschineUi.sound-launch-audio: HorizontalLayout {
                    height: 24px; spacing: 4px;
                    for label[i] in ["Resample", "Stretch", "Formant"]: MaschineButton {
                        text: label; horizontal-stretch: 1;
                        on: MaschineUi.sound-launch-audio-engine == i;
                        clicked => { MaschineUi.sound-launch(["resample", "stretch", "formant"][i]); }
                    }
                }
                if MaschineUi.sound-launch-audio: Text {
                    text: MaschineUi.sound-launch-audio-engine == 0 ? "Tempo follows pattern · pitch follows speed" : "Tempo follows pattern · pitch preserved";
                    color: Theme.text-dim; font-size: 9px; wrap: word-wrap;
                }
                if MaschineUi.sound-launch-mode != "" || MaschineUi.sound-launch-audio: Text {
                    text: MaschineUi.sound-launch-audio ? "SOURCE LENGTH · focused Audio take" : "FIT ZONE 1 · current BPM · pitch preserved";
                    color: Theme.text-dim; font-size: 9px;
                }
                if MaschineUi.sound-launch-mode != "" || MaschineUi.sound-launch-audio: HorizontalLayout {
                    height: 24px; spacing: 4px;
                    for bars in [1, 2, 4, 8]: MaschineButton {
                        text: bars + " bars"; horizontal-stretch: 1;
                        on: MaschineUi.sound-launch-audio && abs(MaschineUi.sound-launch-bars - bars) < 0.001;
                        clicked => { MaschineUi.sound-launch("fit-" + bars); }
                    }
                }
            }
        }
    }
}

component MaschineBrowser inherits Rectangle {
    in property <color> tint;
    property <int> focused-result: MaschineUi.browser-focus;
    changed focused-result => {
        let top = focused-result * 24px;
        if top < -results.content-y { results.content-y = -top; }
        else if top + 24px > -results.content-y + results.height { results.content-y = min(0px, results.height - top - 24px); }
    }
    background: Theme.well;
    VerticalLayout {
        padding: 5px;
        spacing: 4px;
        HorizontalLayout {
            height: 24px;
            spacing: 4px;
            MaschineButton {
                text: ["Projects", "Groups", "Sounds", "Instruments", "Effects", "Loops", "One-shots"][MaschineUi.browser-kind] + " ▾";
                horizontal-stretch: 1;
                clicked => { kinds.show(); }
                kinds := PopupWindow {
                    y: 26px;
                    width: 150px;
                    Rectangle { background: Theme.panel-raised; border-radius: 5px; border-width: 1px; border-color: Theme.border; }
                    VerticalLayout { padding: 5px; spacing: 3px;
                        for name[i] in ["Projects", "Groups", "Sounds", "Instruments", "Effects", "Loops", "One-shots"]: MaschineButton {
                            text: name; on: i == MaschineUi.browser-kind;
                            clicked => { MaschineUi.browser-kind-pick(i); kinds.close(); }
                        }
                    }
                }
            }
            MaschineButton { text: MaschineUi.browser-user ? "USER" : "FACTORY"; width: 62px; on: MaschineUi.browser-user; clicked => { MaschineUi.browser-action("source"); } }
            MaschineButton { text: "★"; width: 28px; on: MaschineUi.browser-favorites; clicked => { MaschineUi.browser-action("favorites"); } }
        }
        HorizontalLayout {
            height: 24px;
            spacing: 3px;
            for filter[i] in MaschineUi.browser-filters: MaschineButton {
                text: filter.options[filter.current] + " ▾";
                horizontal-stretch: 1;
                clicked => { options.show(); }
                options := PopupWindow {
                    y: 26px;
                    width: 210px;
                    height: min(300px, filter.options.length * 27px + 10px);
                    Rectangle { background: Theme.panel-raised; border-radius: 5px; border-width: 1px; border-color: Theme.border; }
                    ListView {
                        x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
                        for name[j] in filter.options: MaschineButton {
                            text: name; on: j == filter.current;
                            clicked => { MaschineUi.browser-filter(i, j); options.close(); }
                        }
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            results := ListView {
                for result[i] in MaschineUi.browser-results: Rectangle {
                    height: 24px;
                    background: i == MaschineUi.browser-focus ? tint.with-alpha(0.18) : ta.has-hover ? Theme.panel-raised : transparent;
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        spacing: 4px;
                        Text { text: result.name; color: Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: result.favorite ? "★" : ""; color: tint; font-size: 11px; vertical-alignment: center; width: 15px; }
                    }
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { MaschineUi.browser-focus-result(i, false); }
                        double-clicked => { MaschineUi.browser-focus-result(i, true); }
                    }
                }
            }
            if MaschineUi.browser-results.length == 0: Text { text: MaschineUi.browser-busy ? "Searching…" : "No results"; color: Theme.text-dim; font-size: 11px; }
        }
        HorizontalLayout {
            height: 24px;
            spacing: 4px;
            MaschineButton { text: "PREHEAR"; horizontal-stretch: 1; enabled: MaschineUi.browser-results.length > 0; clicked => { MaschineUi.browser-action("prehear"); } }
            MaschineButton { text: "★"; width: 28px; enabled: MaschineUi.browser-results.length > 0; clicked => { MaschineUi.browser-action("favorite"); } }
            MaschineButton { text: "LOAD"; horizontal-stretch: 1; enabled: MaschineUi.browser-results.length > 0; clicked => { MaschineUi.browser-action("load"); } }
        }
    }
}

export component MaschinePanel inherits Rectangle {
    in property <int> deck;
    in property <string> channel;
    in property <color> tint;
    property <string> group: "[Maschine" + (deck + 1) + "]";
    property <int> group-index: Controls.value(Controls.resolve(group, "group"), Controls.tick);
    property <int> sound: Controls.value(Controls.resolve(group, "sound"), Controls.tick);
    property <int> pattern: Controls.value(Controls.resolve(group, "pattern"), Controls.tick);
    property <int> scene: Controls.value(Controls.resolve(group, "scene"), Controls.tick);
    property <int> playing-scene: Controls.value(Controls.resolve(group, "playing_scene"), Controls.tick);
    property <int> queued-scene: Controls.value(Controls.resolve(group, "queued_scene"), Controls.tick);
    property <int> pitch-low: 48;
    property <string> groove-group: "[Groove" + (deck + 1) + "]";
    property <string> rhythm-prefix: "group" + (group-index + 1) + "_rhythm_";
    property <bool> rhythm-profile: Controls.value(Controls.resolve(group, rhythm-prefix + "has_profile"), Controls.tick) > 0;
    property <bool> rhythm-ready: rhythm-profile && Controls.value(Controls.resolve(group, rhythm-prefix + "has_pattern"), Controls.tick) > 0;
    background: Theme.panel;
    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        HorizontalLayout {
            height: 28px;
            spacing: 4px;
            ControlButton { group: channel; key: "play"; text: "▶"; width: 34px; height: 28px; tint: tint; fill-when-lit: true; }
            ControlButton { group: group; key: "record"; text: "●"; width: 28px; height: 28px; tint: Theme.c-ff453a; fill-when-lit: true; }
            Text { text: MaschineUi.project-name; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
            MaschineButton { text: MaschineUi.content-import-busy ? "IMPORT…" : "IMPORT"; width: 54px; on: MaschineUi.content-import-busy; clicked => { content-import.show(); }
                content-import := PopupWindow {
                    x: -260px;
                    y: 30px;
                    width: 420px;
                    height: 300px;
                    Rectangle { background: Theme.panel-raised; border-radius: 5px; border-width: 1px; border-color: Theme.border; }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text { text: "IMPORT CONTENT BANK"; color: Theme.text; font-size: 12px; font-weight: 600; }
                        ScrollView {
                            gutter: true;
                            Text { width: parent.visible-width; text: MaschineUi.content-import-report; wrap: word-wrap; color: Theme.text; font-size: 11px; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            MaschineButton { text: MaschineUi.content-import-busy ? "IMPORTING…" : "CHOOSE CONTENT JSON"; horizontal-stretch: 1; enabled: !MaschineUi.content-import-busy; clicked => { MaschineUi.import-content(); } }
                            MaschineButton { text: "CLOSE"; width: 52px; clicked => { content-import.close(); } }
                        }
                    }
                }
            }
            MaschineButton {
                text: "VIEW ▾"; width: 58px; clicked => { view-menu.show(); }
                view-menu := PopupWindow {
                    x: -150px; y: 30px; width: 240px;
                    GrooveMenuBackground { }
                    VerticalLayout { padding: 6px; spacing: 4px;
                        HorizontalLayout { spacing: 3px;
                            for name in ["Perform", "Edit", "Compact"]: MaschineButton {
                                text: name; horizontal-stretch: 1;
                                clicked => { MaschineUi.view-change(name); }
                            }
                        }
                        MaschineButton { text: "Sampling"; clicked => { MaschineUi.context = 2; if !MaschineUi.show-editor { MaschineUi.view-change("Steps / piano"); } MaschineUi.view-change("context"); view-menu.close(); } }
                        for item in [
                            { name: "Pads", on: MaschineUi.show-pads },
                            { name: "Steps / piano", on: MaschineUi.show-editor },
                            { name: "Parameters", on: MaschineUi.show-parameters },
                            { name: "Browser", on: MaschineUi.show-browser },
                            { name: "Performance", on: MaschineUi.show-performance }
                        ]: GrooveMenuItem {
                            text: item.name; checked: item.on;
                            clicked => { MaschineUi.view-change(item.name); }
                        }
                    }
                }
            }
            MaschineButton { text: "OPEN"; width: 42px; clicked => { MaschineUi.open-project(); } }
            MaschineButton { text: "SAVE"; width: 42px; clicked => { MaschineUi.save-project(); } }
            MaschineButton {
                text: "PAD ⚙"; width: 52px; clicked => { calibration.show(); }
                calibration := PopupWindow {
                    y: 30px; width: 360px; height: 310px;
                    PadCalibration { tint: root.tint; }
                }
            }
            MaschineButton {
                text: "ENCODERS"; width: 74px; clicked => { encoder-calibration.show(); }
                encoder-calibration := PopupWindow {
                    y: 30px; x: -200px; width: 390px; height: 258px;
                    close-policy: no-auto-close;
                    EncoderCalibration { tint: root.tint; close => { encoder-calibration.close(); } }
                }
            }
            ControlButton { group: group; key: "undo"; text: "↶"; momentary: true; width: 26px; height: 26px; }
            ControlButton { group: group; key: "redo"; text: "↷"; momentary: true; width: 26px; height: 26px; }
            MaschineButton { text: "DECKARD ▾"; width: 84px; on: true; clicked => { backend.show(); }
                backend := PopupWindow {
                    y: 30px;
                    width: 168px;
                    Rectangle { background: Theme.panel-raised; border-radius: 5px; border-width: 1px; border-color: Theme.border; }
                    VerticalLayout { padding: 5px; spacing: 4px;
                        MaschineButton { text: "Deckard · 16 Sounds"; on: true; clicked => { backend.close(); } }
                        MaschineButton { text: "Original Groove Box"; clicked => { Controls.set-value(Controls.resolve("[Groove" + (deck + 1) + "]", "backend"), 0); backend.close(); } }
                    }
                }
            }
        }
        if MaschineUi.show-performance: GrooveLibraryBar { deck: deck; compact: root.width < 600px; control-height: 26px; native-group: group; target-name: "Group " + ["A", "B", "C", "D", "E", "F", "G", "H"][group-index]; g: groove-group; tint: tint; height: 26px; }
        HorizontalLayout {
            height: 26px;
            spacing: 4px;
            if MaschineUi.show-performance: GrooveSlots { g: groove-group; tint: tint; control-height: 26px; }
            GrooveTempo { g: "[Groove" + (deck + 1) + "]"; tint: tint; width: 74px; height: 26px; menu-right-aligned: false; }
            MaschineButton {
                text: "REC QUANT ▾";
                width: 84px;
                on: Controls.value(Controls.resolve(group, "quantize"), Controls.tick) > 0;
                clicked => { record-grid.show(); }
                record-grid := PopupWindow {
                    y: 28px;
                    width: 220px;
                    Rectangle { background: Theme.panel-raised; border-radius: 5px; border-width: 1px; border-color: Theme.border; }
                    VerticalLayout {
                        padding: 6px;
                        spacing: 5px;
                        ControlButton { group: group; key: "quantize"; text: "QUANTIZE RECORDED NOTES"; height: 26px; font-size: 10px; tint: tint; }
                        HorizontalLayout {
                            spacing: 3px;
                            for ticks[i] in [960, 480, 240, 120, 60]: MaschineButton {
                                text: ["1/4", "1/8", "1/16", "1/32", "1/64"][i];
                                horizontal-stretch: 1;
                                on: Controls.value(Controls.resolve(group, "grid"), Controls.tick) == ticks;
                                clicked => { Controls.set-value(Controls.resolve(group, "grid"), ticks); }
                            }
                        }
                    }
                }
            }
            PerformanceStatus { g: "[Groove" + (deck + 1) + "]"; channel: channel; tint: tint; }
            MaschineButton {
                text: "KEY · " + MaschineUi.harmony-label;
                width: 132px;
                on: Controls.value(Controls.resolve(group, "harmony_mode"), Controls.tick) > 0;
                tint: tint;
                clicked => { harmony.show(); }
                harmony := PopupWindow {
                    y: 28px;
                    x: -250px;
                    width: 440px;
                    height: 510px;
                    HarmonicTools { group: root.group; tint: root.tint; }
                }
            }
        }
        HorizontalLayout {
            height: 66px; spacing: 4px;
            for letter[i] in ["A", "B", "C", "D", "E", "F", "G", "H"]: VerticalLayout {
                horizontal-stretch: 1; min-width: 0px; spacing: 2px;
                MaschineButton {
                    text: (MaschineUi.groups[i].playing ? "▶ " : "") + letter + (MaschineUi.groups[i].muted ? " · M" : "");
                    height: 24px; tint: MaschineUi.groups[i].color; on: i == group-index;
                    clicked => { Controls.set-value(Controls.resolve(group, "group"), i); }
                }
                Text { text: MaschineUi.groups[i].assigned-pattern-name != "" ? MaschineUi.groups[i].assigned-pattern-name : MaschineUi.groups[i].sound-loaded > 0 ? "Pads / free" : "Empty"; height: 14px; color: Theme.text-dim; font-size: 8px; overflow: elide; horizontal-alignment: center; }
                MaschineButton {
                    text: MaschineUi.groups[i].cue ? "CUE" : "MASTER"; height: 22px;
                    tint: MaschineUi.groups[i].cue ? Theme.c-ffd60a : MaschineUi.groups[i].color;
                    on: MaschineUi.groups[i].cue;
                    clicked => { Controls.set-value(Controls.resolve(group, "group_cue" + (i + 1)), MaschineUi.groups[i].cue ? 0 : 1); }
                }
            }
        }
        HorizontalLayout {
            height: 26px; spacing: 4px;
            MaschineButton {
                text: (scene < MaschineUi.scenes.length ? MaschineUi.scenes[scene].name : "Scene " + (scene + 1)) + " ▾";
                horizontal-stretch: 1;
                min-width: 58px;
                clicked => { scenes.show(); }
                scenes := PopupWindow {
                    y: 28px;
                    width: 260px;
                    height: min(300px, MaschineUi.scenes.length * 44px + 42px);
                    Rectangle { background: Theme.panel-raised; border-radius: 5px; border-width: 1px; border-color: Theme.border; }
                    ListView {
                        x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 42px;
                        for item[i] in MaschineUi.scenes: Rectangle {
                            height: 44px;
                            background: i == scene ? tint.with-alpha(0.12) : transparent;
                            VerticalLayout { padding: 5px; spacing: 2px;
                                Text { text: item.name; color: Theme.text; font-size: 11px; }
                                Text { text: item.references; color: Theme.text-dim; font-size: 9px; overflow: elide; }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { Controls.set-value(Controls.resolve(group, "scene"), i); scenes.close(); } }
                        }
                    }
                    MaschineButton { x: 5px; y: parent.height - 31px; width: parent.width - 10px; text: "+ Scene"; clicked => { MaschineUi.add-scene(); } }
                }
            }
            MaschineButton {
                text: (pattern < MaschineUi.patterns.length ? MaschineUi.patterns[pattern].name : "Pattern " + (pattern + 1)) + " ▾";
                horizontal-stretch: 1;
                min-width: 64px;
                clicked => { patterns.show(); }
                patterns := PopupWindow {
                    y: 28px;
                    width: 220px;
                    height: min(300px, MaschineUi.patterns.length * 38px + 42px);
                    Rectangle { background: Theme.panel-raised; border-radius: 5px; border-width: 1px; border-color: Theme.border; }
                    ListView {
                        x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 42px;
                        for item[i] in MaschineUi.patterns: Rectangle {
                            height: 38px;
                            background: i == pattern ? tint.with-alpha(0.12) : transparent;
                            VerticalLayout { padding: 5px; spacing: 2px;
                                Text { text: item.name; color: Theme.text; font-size: 11px; }
                                Text { text: (i == MaschineUi.assigned-pattern ? "ASSIGNED · " : "") + item.detail; color: Theme.text-dim; font-size: 9px; }
                            }
                            TouchArea { width: parent.width - 45px; mouse-cursor: pointer; clicked => { MaschineUi.pick-pattern(i); patterns.close(); } }
                            MaschineButton { x: parent.width - 44px; y: 5px; width: 40px; text: "Edit"; clicked => { MaschineUi.edit-pattern(i); patterns.close(); } }
                        }
                    }
                    MaschineButton { x: 5px; y: parent.height - 31px; width: parent.width - 10px; text: "+ Pattern"; clicked => { MaschineUi.add-pattern(); } }
                }
            }
        }
        HorizontalLayout {
            height: 24px;
            spacing: 5px;
            MaschineButton {
                text: MaschineUi.groups[group-index].cue ? "RELEASE → MASTER NOW" : "SEND GROUP TO CUE";
                on: MaschineUi.groups[group-index].cue;
                tint: Theme.c-ffd60a;
                clicked => { Controls.set-value(Controls.resolve(group, "group_cue" + (group-index + 1)), MaschineUi.groups[group-index].cue ? 0 : 1); }
            }
            MaschineButton {
                text: MaschineUi.assigned-pattern >= 0 ? "STOP GROUP" : "PLAY GROUP";
                clicked => { MaschineUi.toggle-group-pattern(); }
            }
            Text {
                text: MaschineUi.assigned-pattern-name + (MaschineUi.assigned-pattern < 0 ? " · Group stopped" :
                    (Controls.value(Controls.resolve(channel, "play"), Controls.tick) > 0 ? " · Assigned" : " · Transport stopped")) +
                    (queued-scene >= 0 ? " · Pending scene " + (queued-scene + 1) : "") +
                    (playing-scene >= 0 && playing-scene != scene ? " · Playing scene " + (playing-scene + 1) : "");
                color: Theme.text-dim; font-size: 10px; vertical-alignment: center;
                horizontal-stretch: 1; overflow: elide;
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            if MaschineUi.show-pads: VerticalLayout {
                width: clamp(root.width * 0.24, 128px, 208px);
                spacing: 3px;
                HorizontalLayout {
                    height: 24px;
                    spacing: 3px;
                    ControlButton { group: group; key: "keyboard"; text: "KEYBOARD"; height: 24px; font-size: 9px; tint: tint; horizontal-stretch: 1; }
                    MaschineButton { text: "−8"; width: 28px; height: 24px; clicked => { Controls.set-value(Controls.resolve(group, "octave"), max(-5, Controls.value(Controls.resolve(group, "octave"), Controls.tick) - 1)); } }
                    MaschineButton { text: "+8"; width: 28px; height: 24px; clicked => { Controls.set-value(Controls.resolve(group, "octave"), min(5, Controls.value(Controls.resolve(group, "octave"), Controls.tick) + 1)); } }
                }
                MaschinePads { group: group; selected-group: group-index; sound: sound; tint: tint; vertical-stretch: 1; }
                MaschineButton { text: MaschineUi.selected-sound-name + " · " + MaschineUi.selected-instrument-name + " ▾"; height: 24px; clicked => { MaschineUi.instrument-menu-open = true; } }
            }
            if MaschineUi.show-editor: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    height: 24px;
                    spacing: 3px;
                    for name[i] in ["PATTERN", root.width < 600px ? "PIANO" : "PIANO ROLL", "SAMPLING"]: MaschineButton {
                        text: name;
                        on: MaschineUi.context == i;
                        tint: tint;
                        horizontal-stretch: 1;
                        clicked => { MaschineUi.context = i; MaschineUi.view-change("context"); }
                    }
                    if MaschineUi.context == 1: MaschineButton { text: "−"; width: 24px; clicked => { pitch-low = max(0, pitch-low - 12); } }
                    if MaschineUi.context == 1: MaschineButton { text: "+"; width: 24px; clicked => { pitch-low = min(104, pitch-low + 12); } }
                }
                if MaschineUi.context < 2: MaschineNotes {
                    vertical-stretch: 1;
                    piano: MaschineUi.context == 1;
                    sound: sound;
                    tint: tint;
                    pitch-low <=> pitch-low;
                    position: Controls.value(Controls.resolve(group, "position"), Controls.tick);
                    playing: Controls.value(Controls.resolve(group, "playing"), Controls.tick) > 0;
                }
                if MaschineUi.context == 2: MaschineSampling { vertical-stretch: 1; tint: tint; }

            }
            if MaschineUi.show-browser: MaschineBrowser { width: !MaschineUi.show-pads && !MaschineUi.show-editor ? root.width - 12px : max(180px, root.width * 0.35); vertical-stretch: 1; tint: tint; }
            if !MaschineUi.show-pads && !MaschineUi.show-editor && !MaschineUi.show-browser: Rectangle { vertical-stretch: 1; }
        }
        if MaschineUi.show-parameters: HorizontalLayout {
            height: 56px;
            spacing: 4px;
            VerticalLayout {
                width: 62px;
                spacing: 2px;
                Text { text: MaschineUi.parameter-page; color: Theme.text-dim; font-size: 9px; overflow: elide; height: 24px; }
                HorizontalLayout { spacing: 3px;
                    MaschineButton { text: "‹"; width: 26px; clicked => { MaschineUi.parameter-page-step(-1); } }
                    MaschineButton { text: "›"; width: 26px; clicked => { MaschineUi.parameter-page-step(1); } }
                }
            }
            for parameter[i] in MaschineUi.parameters: MaschineKnob { horizontal-stretch: 1; min-width: 0px; parameter: parameter; tint: tint; changed(value) => { MaschineUi.set-parameter(i, value); } }
        }
        if MaschineUi.show-performance: HorizontalLayout {
            height: 26px; spacing: 4px;
            GrooveDice { g: groove-group; enabled: rhythm-ready; tint: tint; width: 30px; height: 26px; }
            GrooveFillBar { g: groove-group; tint: tint; show-four: false; compact: true; enabled: rhythm-ready; horizontal-stretch: 1; min-width: 0px; }
            MaschineButton {
                text: rhythm-profile ? "ROLES ▾" : "MAP DRUMS ▾";
                width: 92px; on: rhythm-profile;
                clicked => { MaschineUi.rhythm-edit(group-index); rhythm-map.show(); }
                rhythm-map := PopupWindow {
                    y: -340px; x: -270px; width: 360px; height: 336px;
                    GrooveMenuBackground { }
                    VerticalLayout { padding: 8px; spacing: 4px;
                        Text { text: "Percussion roles · Group " + ["A", "B", "C", "D", "E", "F", "G", "H"][MaschineUi.rhythm-edit-group]; color: Theme.text; font-size: 12px; height: 20px; }
                        for name[r] in ["Kick", "Snare", "Closed hat", "Open hat", "Clap", "Rim", "Cowbell", "Cymbal"]: HorizontalLayout {
                            height: 25px; spacing: 4px;
                            Text { text: name; color: Theme.text-dim; width: 72px; font-size: 10px; vertical-alignment: center; }
                            MaschineButton {
                                horizontal-stretch: 1;
                                enabled: MaschineUi.rhythm-edit-group == group-index;
                                text: (MaschineUi.rhythm-roles[r] < 0 ? "Unmapped" : (MaschineUi.rhythm-roles[r] + 1) + " · " + MaschineUi.sounds[MaschineUi.rhythm-roles[r]].name) + " ▾";
                                clicked => { sound-choice.show(); }
                                sound-choice := PopupWindow {
                                    x: -60px; y: 26px; width: 240px; height: 300px;
                                    GrooveMenuBackground { }
                                    ScrollView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                                      VerticalLayout {
                                        GrooveMenuItem { text: "Unmapped"; checked: MaschineUi.rhythm-roles[r] < 0; clicked => { MaschineUi.rhythm-role(r, -1); sound-choice.close(); } }
                                        for sound[s] in MaschineUi.sounds: GrooveMenuItem {
                                            text: (s + 1) + " · " + sound.name; checked: MaschineUi.rhythm-roles[r] == s;
                                            clicked => { MaschineUi.rhythm-role(r, s); sound-choice.close(); }
                                        }
                                      }
                                    }
                                }
                            }
                            MaschineButton {
                                text: "LOCK"; width: 40px; height: 25px; tint: tint;
                                enabled: rhythm-ready && !MaschineUi.rhythm-map-changed && MaschineUi.rhythm-edit-group == group-index;
                                on: Controls.value(Controls.resolve(groove-group, "row" + (r + 1) + "_lock"), Controls.tick) > 0;
                                clicked => { let index = Controls.resolve(groove-group, "row" + (r + 1) + "_lock"); Controls.set-value(index, Controls.value(index, Controls.tick) > 0 ? 0 : 1); }
                            }
                            GrooveDice { g: groove-group; track: r + 1; enabled: rhythm-ready && !MaschineUi.rhythm-map-changed && MaschineUi.rhythm-edit-group == group-index && MaschineUi.rhythm-roles[r] >= 0; width: 26px; height: 25px; tint: tint; }
                        }
                        Text { text: MaschineUi.rhythm-edit-group != group-index ? "Group changed · reopen this mapping." : !MaschineUi.rhythm-map-valid ? "Choose a different Sound for each role." : MaschineUi.rhythm-map-changed ? "Apply mapping to use these roles." : "Each role uses a different Sound."; color: MaschineUi.rhythm-map-valid ? Theme.text-dim : Theme.c-ff9f0a; font-size: 10px; height: 20px; }
                        HorizontalLayout { spacing: 4px;
                            MaschineButton { text: "Disable"; enabled: MaschineUi.rhythm-edit-group == group-index; clicked => { Controls.set-value(Controls.resolve(group, rhythm-prefix + "profile"), 0); rhythm-map.close(); } }
                            MaschineButton { text: "Legacy 1–8"; enabled: MaschineUi.rhythm-edit-group == group-index; clicked => { Controls.set-value(Controls.resolve(group, rhythm-prefix + "profile"), 1); rhythm-map.close(); } }
                            MaschineButton { text: "Apply mapping"; enabled: MaschineUi.rhythm-map-valid && MaschineUi.rhythm-edit-group == group-index; clicked => { MaschineUi.rhythm-apply(group-index); rhythm-map.close(); } }
                        }
                    }
                }
            }
        }
        if MaschineUi.show-performance && !rhythm-ready: Text { text: rhythm-profile ? "Select a Group pattern for Fill / Remix / Dice." : "Map percussion roles for Fill / Remix / Dice."; color: Theme.text-dim; font-size: 10px; height: 14px; }
        if MaschineUi.status != "": Text { text: MaschineUi.status; color: Theme.c-ff9f0a; font-size: 10px; overflow: elide; height: 14px; }
    }
    if MaschineUi.instrument-menu-open: Rectangle {
        background: Theme.s-00000088;
        TouchArea { clicked => { MaschineUi.instrument-menu-open = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 12px;
            width: min(320px, parent.width - 24px);
            height: parent.height - 24px;
            background: Theme.panel-raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    height: 26px;
                    Text { text: "Instrument · " + MaschineUi.selected-sound-name; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    MaschineButton { text: "×"; width: 26px; clicked => { MaschineUi.instrument-menu-open = false; } }
                }
                ListView {
                    vertical-stretch: 1;
                    for instrument[i] in MaschineUi.instruments: Rectangle {
                        height: 38px;
                        border-radius: 4px;
                        background: ta.has-hover ? Theme.control-pressed : Theme.panel;
                        VerticalLayout {
                            padding: 5px;
                            spacing: 2px;
                            Text { text: instrument.name; color: Theme.text; font-size: 11px; }
                            Text { text: instrument.detail; color: Theme.text-dim; font-size: 9px; overflow: elide; }
                        }
                        ta := TouchArea { mouse-cursor: pointer; clicked => { MaschineUi.load-instrument(i); MaschineUi.instrument-menu-open = false; } }
                    }
                }
            }
        }
    }
}
